@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.Extensions.Logging
@inject NavigationManager NavManager
@inject IDatabaseService DbService
@inject ILocalAuthService AuthService
@inject IExpenseCategorizerService Categorizer
@inject IStringLocalizer<AppStrings> L
@inject ILogger<MainLayout> Logger

<div class="app-container">
    @if (_isInitializing)
    {
        <div class="app-loading-screen">
            <div class="spinner-glow"></div>
            <div class="loading-title">SmartBudget <span>ML</span></div>
            <div class="loading-subtitle">@L["Layout_InitializingVault"]</div>
        </div>
    }
    else
    {
        @if (!IsChromeless)
        {
            <header class="app-header">
                <div class="brand-section">
                    <div class="brand-title">
                        SmartBudget <span class="brand-ml-tag">ML</span>
                    </div>
                    <div class="brand-subtitle">@GreetingText</div>
                </div>

                <button id="btn-notifications" class="header-action-btn" type="button" title="@L["Layout_LockApp"]" @onclick="LockApp">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                </button>
            </header>
        }

        <main class="app-content @(IsChromeless ? "chromeless" : "")">
            @Body
        </main>

        @if (!IsChromeless)
        {
            <NavMenu />
        }
    }
</div>

@code {
    private bool _isInitializing = true;
    private string? UserDisplayName;

    private string GreetingText
    {
        get
        {
            var hour = DateTime.Now.Hour;
            var salutation = hour < 12 ? L["Layout_GoodMorning"].Value : hour < 18 ? L["Layout_GoodAfternoon"].Value : L["Layout_GoodEvening"].Value;
            return string.IsNullOrWhiteSpace(UserDisplayName) ? salutation : $"{salutation}, {UserDisplayName}";
        }
    }

    private static readonly string[] ChromelessRoutes = { "onboarding", "unlock", "vault-error" };

    private bool IsChromeless
    {
        get
        {
            var relative = NavManager.ToBaseRelativePath(NavManager.Uri).Split('?', '#')[0].Trim('/');
            return ChromelessRoutes.Contains(relative, StringComparer.OrdinalIgnoreCase);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        NavManager.LocationChanged += OnLocationChanged;
        L.OnLanguageChanged += OnLanguageChanged;
        AuthService.LockStateChanged += OnLockStateChanged;

        try
        {
            await DbService.InitializeAsync();
            await DbService.SeedDefaultDataAsync();

            var settings = await AuthService.GetSettingsAsync();
            if (!string.IsNullOrWhiteSpace(settings.Language))
            {
                L.SetLanguage(settings.Language);
            }

            _ = Task.Run(async () =>
            {
                try
                {
                    await Categorizer.EnsureTrainedAsync();
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Background ML categorizer initialization failed.");
                }
            });

            await CheckAuthRouteAsync();
        }
        catch (VaultUnavailableException ex)
        {
            Logger.LogError(ex, "Database vault unavailable: {State}.", ex.State);
            NavManager.NavigateTo("vault-error", replace: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing MainLayout.");
        }
        finally
        {
            _isInitializing = false;
        }
    }

    private async Task CheckAuthRouteAsync()
    {
        var relative = NavManager.ToBaseRelativePath(NavManager.Uri).Split('?', '#')[0].Trim('/');
        var isRegistered = await AuthService.IsUserRegisteredAsync();

        if (!isRegistered)
        {
            if (!string.Equals(relative, "onboarding", StringComparison.OrdinalIgnoreCase))
            {
                NavManager.NavigateTo("onboarding");
            }
            return;
        }

        var profile = await AuthService.GetUserProfileAsync();
        if (profile != null)
        {
            UserDisplayName = profile.FullName;
        }

        if (!AuthService.IsAppUnlocked)
        {
            if (!string.Equals(relative, "unlock", StringComparison.OrdinalIgnoreCase) &&
                !string.Equals(relative, "onboarding", StringComparison.OrdinalIgnoreCase))
            {
                NavManager.NavigateTo("unlock");
            }
        }
    }

    private void LockApp()
    {
        // Navigation to /unlock is done by OnLockStateChanged.
        AuthService.LockApp();
    }

    private void OnLockStateChanged(object? sender, EventArgs e)
        => InvokeAsync(() =>
        {
            var relative = NavManager.ToBaseRelativePath(NavManager.Uri);
            var target = LockNavigationCoordinator.GetRedirect(relative, AuthService.IsAppUnlocked);
            if (target != null)
            {
                NavManager.NavigateTo(target, replace: true);
            }
        });

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    private void OnLanguageChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        NavManager.LocationChanged -= OnLocationChanged;
        L.OnLanguageChanged -= OnLanguageChanged;
        AuthService.LockStateChanged -= OnLockStateChanged;
    }
}
