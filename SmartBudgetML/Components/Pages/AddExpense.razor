@page "/add-expense"
@implements IDisposable
@using Microsoft.Extensions.Logging
@using SmartBudgetML.Services.ML.Models
@inject NavigationManager NavManager
@inject IDatabaseService DbService
@inject IAppSettingsProvider SettingsProvider
@inject ILocalAuthService AuthService
@inject IExpenseCategorizerService Categorizer
@inject IStringLocalizer<AppStrings> L
@inject ILogger<AddExpense> Logger

<PageTitle>@L["AddExpense_PageTitle"]</PageTitle>

<div class="add-expense-container">
    @* Screen Header *@
    <div class="screen-header-row">
        <div>
            <h1 class="screen-title">@L["AddExpense_Title"]</h1>
            <p class="screen-subtitle">@L["AddExpense_Subtitle"]</p>
        </div>
        <button id="btn-cancel-expense" class="header-action-btn" type="button" title="@L["AddExpense_Cancel"]" @onclick="GoHome">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
    </div>

    @* Hero Amount Display with Segmented Toggle *@
    <div class="amount-hero-box" id="box-amount-display">
        <span class="amount-label">@L["AddExpense_AmountLabel", Currency]</span>
        <div class="amount-display-row">
            <span class="amount-symbol">@Currency</span>
            <span>@FormattedAmount</span>
            <span class="amount-cursor"></span>
        </div>

        <div class="segmented-control">
            <button id="btn-type-expense" type="button" class="segmented-btn @(!IsIncome ? "active" : "")" @onclick="() => IsIncome = false">
                @L["AddExpense_Expense"]
            </button>
            <button id="btn-type-income" type="button" class="segmented-btn @(IsIncome ? "active" : "")" @onclick="() => IsIncome = true">
                @L["AddExpense_Income"]
            </button>
        </div>
    </div>

    @* Transaction Details Form *@
    <div class="card-dark">
        <div class="form-group-dark">
            <label class="form-label-dark" for="input-description">@L["AddExpense_Description"]</label>
            <input id="input-description" class="form-input-dark" placeholder="@L["AddExpense_DescriptionPlaceholder"]"
                   @bind="Description" @bind:event="oninput" @bind:after="OnDescriptionChangedAsync" autocomplete="off" />
        </div>

        @* Real-Time Hybrid Auto-Categorization Suggestion Banner *@
        @if (!string.IsNullOrWhiteSpace(PredictedCategoryName))
        {
            <div class="ml-suggestion-pill" id="ml-suggestion-banner">
                <div class="ml-pill-left">
                    <span>✨</span>
                    <span>@L["AddExpense_SuggestionLabel"] <strong>@PredictedCategoryDisplayName</strong> @PredictionSourceBadge</span>
                    <span class="ml-pill-confidence">@((int)((PredictionConfidence ?? 0.0f) * 100))%</span>
                </div>
                <button id="btn-accept-ml" type="button" class="ml-pill-accept-btn" @onclick="ApplyMlSuggestion">
                    @L["AddExpense_Apply"]
                </button>
            </div>
        }

        @* Category Selection Grid *@
        <div class="category-picker-header" style="margin-top: 14px;">
            <label class="form-label-dark">@L["AddExpense_Category"]</label>
            @if (SelectedCategory != null)
            {
                <span class="text-secondary" style="font-size: 11px;">@L["AddExpense_Selected"] <strong style="color:var(--accent-cyan)">@CategoryCatalog.GetDisplayName(SelectedCategory, L.CurrentLanguage)</strong></span>
            }
        </div>

        <div class="category-chips-grid" id="category-grid">
            @foreach (var cat in DisplayCategories)
            {
                var isSelected = SelectedCategoryId == cat.Id;
                <div class="category-chip @(isSelected ? "selected" : "")" id="@($"cat-chip-{cat.Id}")" @onclick="() => SelectCategory(cat)">
                    <span class="category-chip-glyph">@UiFormat.CategoryGlyph(cat.Icon)</span>
                    <span class="category-chip-name">@CategoryCatalog.GetDisplayName(cat, L.CurrentLanguage)</span>
                </div>
            }
        </div>

        @* Date & Fixed Expense Option *@
        <div class="form-row" style="margin-top: 14px;">
            <div class="form-group-dark flex-1">
                <label class="form-label-dark" for="input-date">@L["AddExpense_Date"]</label>
                <input id="input-date" type="date" class="form-input-dark" @bind="Date" />
            </div>
        </div>

        @if (!IsIncome)
        {
            <div class="form-row" style="margin-top: 10px; align-items: center;">
                <label style="display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--text-secondary); cursor: pointer;">
                    <input id="chk-fixed-expense" type="checkbox" @bind="IsFixedOrRecurring" />
                    <span>@L["AddExpense_FixedExpenseCheck"]</span>
                </label>
            </div>
        }

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="form-error" role="alert" style="margin-top: 10px;">@ErrorMessage</div>
        }
    </div>

    @* Fast Numeric Touch Keypad *@
    <div class="card-dark">
        <NumericKeypad IdPrefix="expense" LeftKey="KeypadLeftKey.Decimal" OnKey="HandleKeypad" />
    </div>

    @* Primary Action Button *@
    <button id="btn-submit-expense" type="button" class="btn-primary-gradient" disabled="@IsSubmitting" @onclick="SaveTransaction">
        @if (IsSubmitting)
        {
            <span>@L["AddExpense_Saving"]</span>
        }
        else
        {
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>@(IsIncome ? L["AddExpense_SubmitIncome"] : L["AddExpense_SubmitExpense"])</span>
        }
    </button>
</div>

@code {
    private const int DebounceDelayMs = 300;
    private CancellationTokenSource? _debounceCts;

    private string Currency = "FCFA";
    private string RawAmount = "0";
    private bool IsIncome = false;
    private bool IsFixedOrRecurring = false;
    private string Description = string.Empty;
    private DateTime Date = DateTime.Today;
    private int? SelectedCategoryId;
    private string? PredictedCategoryName;
    private float? PredictionConfidence;
    private PredictionSource LastPredictionSource = PredictionSource.None;
    private string? MatchedRuleKeyword;
    private bool IsMlApplied = false;
    private string? ErrorMessage;
    private bool IsSubmitting = false;

    private List<Category> Categories = new();

    private IEnumerable<Category> DisplayCategories =>
        Categories.Where(c => c.IsIncome == IsIncome);

    private Category? SelectedCategory =>
        Categories.FirstOrDefault(c => c.Id == SelectedCategoryId);

    private string PredictedCategoryDisplayName
    {
        get
        {
            var matched = FindMatchingCategory(PredictedCategoryName);
            return matched != null ? CategoryCatalog.GetDisplayName(matched, L.CurrentLanguage) : (PredictedCategoryName ?? string.Empty);
        }
    }

    private string PredictionSourceBadge => LastPredictionSource switch
    {
        PredictionSource.UserMemory => "(mémoire)",
        PredictionSource.Rules when !string.IsNullOrWhiteSpace(MatchedRuleKeyword) => $"(règle : « {MatchedRuleKeyword} »)",
        PredictionSource.Rules => "(règle)",
        PredictionSource.Model => "(ML)",
        _ => string.Empty
    };

    private string FormattedAmount
    {
        get
        {
            if (string.IsNullOrEmpty(RawAmount) || RawAmount == "0") return "0";
            if (decimal.TryParse(RawAmount, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var parsed))
            {
                return parsed % 1 == 0
                    ? parsed.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)
                    : parsed.ToString("N2", System.Globalization.CultureInfo.InvariantCulture);
            }
            return RawAmount;
        }
    }

    private decimal ParsedAmount =>
        decimal.TryParse(RawAmount, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var val) ? val : 0m;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var profile = await AuthService.GetUserProfileAsync();
            if (profile != null && !string.IsNullOrWhiteSpace(profile.CurrencySymbol))
            {
                Currency = profile.CurrencySymbol;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load user profile currency in AddExpense.");
        }

        await LoadCategoriesAsync();
        EnsureDefaultSelection();
    }

    private async Task LoadCategoriesAsync()
    {
        try
        {
            Categories = await DbService.Categories.GetAllAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load categories from SQLite; falling back to default preview categories.");
        }

        if (Categories == null || Categories.Count == 0)
        {
            Categories = CategoryCatalog.GetCameroonianDefaultCategories();
            for (int i = 0; i < Categories.Count; i++)
            {
                Categories[i].Id = i + 1;
            }
        }
    }

    private void EnsureDefaultSelection()
    {
        var match = DisplayCategories.FirstOrDefault();
        if (match != null && SelectedCategoryId == null)
        {
            SelectedCategoryId = match.Id;
        }
    }

    private void HandleKeypad(string key)
    {
        ErrorMessage = null;
        if (key == "back")
        {
            RawAmount = RawAmount.Length > 1 ? RawAmount[..^1] : "0";
            return;
        }

        if (key == ".")
        {
            if (!RawAmount.Contains('.'))
            {
                RawAmount += ".";
            }
            return;
        }

        if (RawAmount == "0")
        {
            RawAmount = key;
        }
        else
        {
            var dotIndex = RawAmount.IndexOf('.');
            if (dotIndex >= 0 && RawAmount.Length - dotIndex > 2)
            {
                return;
            }
            if (RawAmount.Length < 9)
            {
                RawAmount += key;
            }
        }
    }

    private Category? FindMatchingCategory(string? categoryNameOrKey)
    {
        if (string.IsNullOrWhiteSpace(categoryNameOrKey)) return null;

        var resolvedKey = CategoryCatalog.ResolveCategoryKey(categoryNameOrKey);
        if (!string.IsNullOrWhiteSpace(resolvedKey))
        {
            var byKey = Categories.FirstOrDefault(c => string.Equals(c.Key, resolvedKey, StringComparison.OrdinalIgnoreCase));
            if (byKey != null) return byKey;
        }

        return Categories.FirstOrDefault(c => c.Name.Equals(categoryNameOrKey, StringComparison.OrdinalIgnoreCase));
    }

    private async Task OnDescriptionChangedAsync()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        if (string.IsNullOrWhiteSpace(Description) || Description.Length < 2)
        {
            PredictedCategoryName = null;
            PredictionConfidence = null;
            LastPredictionSource = PredictionSource.None;
            MatchedRuleKeyword = null;
            return;
        }

        try
        {
            await Task.Delay(DebounceDelayMs, token);
            if (token.IsCancellationRequested) return;

            var settings = await SettingsProvider.GetSettingsAsync();
            if (!settings.AutoCategorizeEnabled)
            {
                PredictedCategoryName = null;
                PredictionConfidence = null;
                return;
            }

            var pred = Categorizer.Predict(Description, confidenceThreshold: settings.MlConfidenceThreshold);
            if (pred != null && !string.IsNullOrEmpty(pred.PredictedCategory) && pred.Source != PredictionSource.Fallback)
            {
                PredictedCategoryName = pred.PredictedCategory;
                PredictionConfidence = pred.Confidence;
                LastPredictionSource = pred.Source;
                MatchedRuleKeyword = pred.MatchedRuleKeyword;

                var shouldAutoSelect = await SettingsProvider.ShouldAutoSelectCategoryAsync(pred.Confidence);
                if (shouldAutoSelect && !IsMlApplied)
                {
                    var matched = FindMatchingCategory(pred.PredictedCategory);
                    if (matched != null)
                    {
                        SelectedCategoryId = matched.Id;
                    }
                }
            }
            else
            {
                PredictedCategoryName = null;
                PredictionConfidence = null;
                LastPredictionSource = PredictionSource.None;
                MatchedRuleKeyword = null;
            }
        }
        catch (TaskCanceledException)
        {
            // Expected during fast user typing
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Hybrid categorization prediction failed for description input.");
        }
    }

    private void ApplyMlSuggestion()
    {
        if (string.IsNullOrEmpty(PredictedCategoryName)) return;
        var matched = FindMatchingCategory(PredictedCategoryName);
        if (matched != null)
        {
            SelectedCategoryId = matched.Id;
            IsMlApplied = true;
        }
    }

    private void SelectCategory(Category cat)
    {
        SelectedCategoryId = cat.Id;
        IsMlApplied = false;
    }

    private async Task SaveTransaction()
    {
        ErrorMessage = null;
        if (ParsedAmount <= 0)
        {
            ErrorMessage = L["AddExpense_ErrAmount"].Value;
            return;
        }

        if (string.IsNullOrWhiteSpace(Description))
        {
            ErrorMessage = L["AddExpense_ErrDescription"].Value;
            return;
        }

        if (SelectedCategoryId == null)
        {
            ErrorMessage = L["AddExpense_ErrCategory"].Value;
            return;
        }

        IsSubmitting = true;
        try
        {
            var chosenCategory = SelectedCategory;
            var expense = new Expense
            {
                Description = Description.Trim(),
                Amount = ParsedAmount,
                Date = Date,
                CategoryId = SelectedCategoryId.Value,
                IsIncome = IsIncome,
                IsFixedOrRecurring = !IsIncome && IsFixedOrRecurring,
                IsMlPredicted = IsMlApplied,
                PredictionConfidence = PredictionConfidence,
                CreatedAt = DateTime.UtcNow
            };

            await DbService.Expenses.InsertAsync(expense);

            if (chosenCategory != null)
            {
                _ = Task.Run(async () =>
                {
                    try
                    {
                        await Categorizer.RecordFeedbackAsync(expense.Description, chosenCategory.Name);
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "Background feedback recording failed.");
                    }
                });
            }

            NavManager.NavigateTo("");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save expense transaction.");
            ErrorMessage = $"Failed to save: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private void GoHome() => NavManager.NavigateTo("");

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }
}
