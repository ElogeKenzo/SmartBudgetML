@page "/settings"
@using Microsoft.Extensions.Logging
@using SmartBudgetML.Services.Data
@inject NavigationManager NavManager
@inject IDatabaseService DbService
@inject IAppSettingsProvider SettingsProvider
@inject ILocalAuthService AuthService
@inject IExpenseCategorizerService Categorizer
@inject IModelEvaluator ModelEvaluator
@inject ICsvExpenseExporter CsvExporter
@inject ILogger<Settings> Logger

<PageTitle>Settings · SmartBudget ML</PageTitle>

<div class="settings-container">
    @* Screen Header *@
    <div class="screen-header-row">
        <div>
            <h1 class="screen-title">Settings</h1>
            <p class="screen-subtitle">Configure AI, security and edge storage</p>
        </div>
        <button id="btn-settings-back" class="header-action-btn" type="button" title="Back" @onclick="GoHome">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(FeedbackMessage))
    {
        <div class="card-dark" role="status" style="margin-bottom: 12px; border-left: 3px solid var(--accent-cyan);">
            <span>@FeedbackMessage</span>
        </div>
    }

    @* Section 1: AI & ML Model Settings *@
    <div class="settings-section-card" id="section-ai-settings">
        <div class="settings-section-header">
            <span class="settings-section-title">
                <span>🤖</span> AI & Model Settings
            </span>
            <span class="status-badge-live">● On-Device ML</span>
        </div>

        <div class="switch-container">
            <div class="switch-label-group">
                <span class="switch-title">Auto-categorize transactions</span>
                <span class="switch-desc">Categorize expense descriptions using SDCA NLP</span>
            </div>
            <ToggleSwitch Id="toggle-auto-categorize" Value="AutoCategorizeEnabled" ValueChanged="OnAutoCategorizeChanged" />
        </div>

        <div class="slider-container bordered-top">
            <div class="slider-label-row">
                <span>ML Model Sensitivity / Threshold</span>
                <span class="slider-value">@MlConfidenceThresholdPercent%</span>
            </div>
            <input id="slider-ml-threshold" type="range" min="50" max="95" step="5" class="range-slider-dark"
                   @bind="MlConfidenceThresholdPercent" @bind:event="oninput" @bind:after="SaveSettingsAsync" />
            <span class="card-footnote">Only predict when model confidence exceeds this threshold.</span>
        </div>

        <div style="margin-top: 6px;">
            <button id="btn-retrain-model" type="button" class="retrain-action-btn" disabled="@IsRetraining" @onclick="RetrainModel">
                @if (IsRetraining)
                {
                    <span>Evaluating & retraining on-device SDCA model...</span>
                }
                else
                {
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="23 4 23 10 17 10"></polyline>
                        <polyline points="1 20 1 14 7 14"></polyline>
                        <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                    </svg>
                    <span>Retrain & Evaluate Model with My Data</span>
                }
            </button>
            <div class="model-metric-track">
                <div class="model-metric-fill" style="width: @(UiFormat.Num(EvaluationMetrics.MicroAccuracy * 100.0))%"></div>
            </div>
            <div class="slider-label-row" style="margin-top: 4px;">
                <span class="card-footnote">
                    Validation score:
                    <strong style="color:var(--accent-cyan)">@EvaluationMetrics.StatusDisplay</strong>
                </span>
                <span class="card-footnote">@EvaluationMetrics.TrainingSampleCount training samples</span>
            </div>
        </div>
    </div>

    @* Section 2: Security & Auto-Lock *@
    <div class="settings-section-card" id="section-security-settings">
        <span class="settings-section-title">
            <span>🛡️</span> Security & Vault Protection
        </span>

        <div class="form-group-dark">
            <label class="form-label-dark" for="select-autolock">Auto-lock timeout on background</label>
            <select id="select-autolock" class="form-input-dark" @bind="AutoLockTimeoutSeconds" @bind:after="SaveSettingsAsync">
                <option value="0">Immediately (0s)</option>
                <option value="30">After 30 seconds</option>
                <option value="60">After 1 minute</option>
                <option value="300">After 5 minutes</option>
            </select>
        </div>

        <div class="switch-container bordered-top">
            <div class="switch-label-group">
                <span class="switch-title">Protect screen (FLAG_SECURE)</span>
                <span class="switch-desc">Hide app preview in task switcher and block screenshots</span>
            </div>
            <ToggleSwitch Id="toggle-screen-protection" Value="IsScreenProtectionEnabled" ValueChanged="OnScreenProtectionChanged" />
        </div>
    </div>

    @* Section 3: Budget & Notifications *@
    <div class="settings-section-card" id="section-budget-settings">
        <span class="settings-section-title">
            <span>📊</span> Budget & Notifications
        </span>

        <div class="form-group-dark">
            <label class="form-label-dark" for="input-monthly-budget">Monthly Budget Limit</label>
            <input id="input-monthly-budget" type="number" min="0" step="50" class="form-input-dark"
                   @bind="MonthlyBudget" @bind:after="SaveBudgetAsync" />
        </div>

        <div class="switch-container bordered-top">
            <div class="switch-label-group">
                <span class="switch-title">Over-budget alerts</span>
                <span class="switch-desc">Notify when spending trajectory exceeds monthly cap</span>
            </div>
            <ToggleSwitch Id="toggle-overbudget-alerts" Value="OverBudgetAlertsEnabled" ValueChanged="OnOverBudgetAlertsChanged" />
        </div>

        <div class="switch-container bordered-top">
            <div class="switch-label-group">
                <span class="switch-title">Daily expense reminders</span>
                <span class="switch-desc">Gentle reminder to log your daily receipts</span>
            </div>
            <ToggleSwitch Id="toggle-daily-reminders" Value="DailyRemindersEnabled" ValueChanged="OnDailyRemindersChanged" />
        </div>
    </div>

    @* Section 4: Data & Storage *@
    <div class="settings-section-card" id="section-data-storage">
        <span class="settings-section-title">
            <span>💾</span> Data & Edge Storage
        </span>

        <div class="settings-action-row" id="row-export-data" @onclick="ExportData">
            <div class="action-row-left">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <span>Export Expense Data (CSV)</span>
            </div>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
        </div>

        <div class="settings-action-row" id="row-backup-data" @onclick="BackupDatabase">
            <div class="action-row-left">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                    <polyline points="17 21 17 13 7 13 7 21"></polyline>
                    <polyline points="7 3 7 8 15 8"></polyline>
                </svg>
                <span>Backup Local Database</span>
            </div>
            <span style="font-size: 11px; color: var(--text-muted);">@DbSize</span>
        </div>

        <div class="settings-action-row danger" id="row-clear-data" @onclick="HandlePurgeClick">
            <div class="action-row-left">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
                <span>@(IsConfirmingPurge ? "⚠️ Tap again to permanently erase vault & key" : "Clear Local Database & Encryption Key")</span>
            </div>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
        </div>
    </div>

    @* App Version Footnote *@
    <p class="card-footnote" style="text-align: center; margin: 12px 0 24px 0;">
        SmartBudget ML · SQLCipher 256-bit · PBKDF2 600k · 100% On-Device
    </p>
</div>

@code {
    private AppSettings? CurrentSettings;
    private bool AutoCategorizeEnabled = true;
    private int MlConfidenceThresholdPercent = 70;
    private int AutoLockTimeoutSeconds = 300;
    private bool IsScreenProtectionEnabled = true;
    private bool IsConfirmingPurge = false;
    private bool IsRetraining = false;
    private ModelEvaluationMetrics EvaluationMetrics = ModelEvaluationMetrics.Unevaluated();
    private string? FeedbackMessage;

    private decimal MonthlyBudget = 3000m;
    private bool OverBudgetAlertsEnabled = true;
    private bool DailyRemindersEnabled = false;
    private string DbSize = "0 B";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            CurrentSettings = await SettingsProvider.GetOrCreateSettingsAsync();
            AutoCategorizeEnabled = CurrentSettings.AutoCategorizeEnabled;
            MlConfidenceThresholdPercent = (int)Math.Round(CurrentSettings.MlConfidenceThreshold * 100f);
            AutoLockTimeoutSeconds = CurrentSettings.AutoLockTimeoutSeconds;
            IsScreenProtectionEnabled = CurrentSettings.IsScreenProtectionEnabled;
            OverBudgetAlertsEnabled = CurrentSettings.OverBudgetAlertsEnabled;
            DailyRemindersEnabled = CurrentSettings.DailyRemindersEnabled;

            var profile = await AuthService.GetUserProfileAsync();
            if (profile != null)
            {
                MonthlyBudget = profile.MonthlyIncome > 0
                    ? Math.Max(100m, profile.MonthlyIncome - profile.MonthlySavingsGoal)
                    : 3000m;
            }

            EvaluationMetrics = ModelEvaluator.GetCurrentMetrics();
            DbSize = await DbService.GetFormattedDatabaseSizeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing Settings page.");
            FeedbackMessage = $"Failed to load settings: {ex.Message}";
        }
    }

    private async Task OnAutoCategorizeChanged(bool enabled)
    {
        AutoCategorizeEnabled = enabled;
        await SaveSettingsAsync();
    }

    private async Task OnScreenProtectionChanged(bool enabled)
    {
        IsScreenProtectionEnabled = enabled;
#if ANDROID
        MainActivity.SetScreenProtection(enabled);
#endif
        await SaveSettingsAsync();
    }

    private async Task OnOverBudgetAlertsChanged(bool enabled)
    {
        OverBudgetAlertsEnabled = enabled;
        await SaveSettingsAsync();
    }

    private async Task OnDailyRemindersChanged(bool enabled)
    {
        DailyRemindersEnabled = enabled;
        await SaveSettingsAsync();
    }

    private async Task SaveSettingsAsync()
    {
        try
        {
            var settings = CurrentSettings ?? await SettingsProvider.GetOrCreateSettingsAsync();
            settings.AutoCategorizeEnabled = AutoCategorizeEnabled;
            settings.MlConfidenceThreshold = Math.Clamp(MlConfidenceThresholdPercent / 100f, 0.05f, 0.99f);
            settings.AutoLockTimeoutSeconds = AutoLockTimeoutSeconds;
            settings.IsScreenProtectionEnabled = IsScreenProtectionEnabled;
            settings.OverBudgetAlertsEnabled = OverBudgetAlertsEnabled;
            settings.DailyRemindersEnabled = DailyRemindersEnabled;
            await SettingsProvider.SaveSettingsAsync(settings);
            CurrentSettings = settings;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving AppSettings.");
            FeedbackMessage = $"Could not save setting: {ex.Message}";
        }
    }

    private async Task SaveBudgetAsync()
    {
        try
        {
            var profile = await AuthService.GetUserProfileAsync();
            if (profile != null && MonthlyBudget > 0)
            {
                profile.MonthlySavingsGoal = Math.Max(0m, profile.MonthlyIncome - MonthlyBudget);
                await AuthService.UpdateUserProfileAsync(profile);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating monthly budget.");
            FeedbackMessage = "Could not save budget setting.";
        }
    }

    private async Task RetrainModel()
    {
        IsRetraining = true;
        FeedbackMessage = null;
        try
        {
            var allExpenses = await DbService.Expenses.GetAllAsync();
            var allCategories = await DbService.Categories.GetAllAsync();
            var catDict = allCategories.ToDictionary(c => c.Id, c => c.Name);

            var userSamples = allExpenses
                .Where(e => !string.IsNullOrWhiteSpace(e.Description) && catDict.ContainsKey(e.CategoryId))
                .Select(e => new ExpenseTransactionData
                {
                    Description = e.Description,
                    CategoryName = catDict[e.CategoryId]
                })
                .ToList();

            await Categorizer.TrainAsync(userSamples);

            var fullTrainSet = SeedTrainingData.GetDefaultDataset();
            fullTrainSet.AddRange(userSamples);
            EvaluationMetrics = await ModelEvaluator.EvaluateAsync(fullTrainSet);

            FeedbackMessage = $"Model retrained & evaluated: {EvaluationMetrics.StatusDisplay} on {EvaluationMetrics.ValidationSampleCount} validation samples.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Retraining failed.");
            FeedbackMessage = $"Retraining failed: {ex.Message}";
        }
        finally
        {
            IsRetraining = false;
        }
    }

    private async Task ExportData()
    {
        try
        {
            var expenses = await DbService.Expenses.GetAllAsync();
            var categories = await DbService.Categories.GetAllAsync();
            var filePath = await CsvExporter.ExportToFileAsync(expenses, categories);

            FeedbackMessage = $"Exported {expenses.Count} transactions to {Path.GetFileName(filePath)}.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "CSV export failed.");
            FeedbackMessage = $"Export failed: {ex.Message}";
        }
    }

    private async Task BackupDatabase()
    {
        try
        {
            var backupDir = Path.GetDirectoryName(DbService.DatabasePath) ?? AppDomain.CurrentDomain.BaseDirectory;
            var backupFile = Path.Combine(backupDir, $"smartbudget_backup_{DateTime.UtcNow:yyyyMMdd_HHmmss}.db3");
            var savedPath = await DbService.BackupDatabaseAsync(backupFile);
            DbSize = await DbService.GetFormattedDatabaseSizeAsync();
            FeedbackMessage = $"Database backed up to {Path.GetFileName(savedPath)} ({DbSize}).";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Database backup failed.");
            FeedbackMessage = $"Backup failed: {ex.Message}";
        }
    }

    private async Task HandlePurgeClick()
    {
        if (!IsConfirmingPurge)
        {
            IsConfirmingPurge = true;
            FeedbackMessage = "Confirm purge: tap the red button again to permanently delete the database file and encryption key.";
            return;
        }

        try
        {
            IsConfirmingPurge = false;
            await DbService.PurgeDatabaseAndKeyAsync();
            await DbService.InitializeAsync();
            AuthService.LockApp();
            NavManager.NavigateTo("onboarding");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Secure database purge failed.");
            FeedbackMessage = $"Failed to purge database: {ex.Message}";
        }
    }

    private void GoHome() => NavManager.NavigateTo("");
}
