@page "/profile"
@using Microsoft.Extensions.Logging
@inject NavigationManager NavManager
@inject ILocalAuthService AuthService
@inject IDatabaseService DbService
@inject ILogger<Profile> Logger

<PageTitle>Your Profile · SmartBudget ML</PageTitle>

<div class="profile-container">
    @* Screen Header *@
    <div class="screen-header-row">
        <div>
            <h1 class="screen-title">Your profile</h1>
            <p class="screen-subtitle">Your account, local and private</p>
        </div>
        <button id="btn-profile-settings" class="header-action-btn" type="button" title="Settings" @onclick="GoToSettings">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="card-dark" role="status" style="margin-bottom: 12px; border-left: 3px solid var(--accent-cyan);">
            <span>@StatusMessage</span>
        </div>
    }

    @* Hero User Profile Card *@
    <div class="profile-hero-card" id="card-profile-header">
        <div class="profile-avatar-large">
            @UiFormat.Initials(User.FullName)
        </div>
        <div class="profile-user-info">
            <h2 class="profile-user-name">@User.FullName</h2>
            <span class="profile-user-email">@(string.IsNullOrWhiteSpace(User.Email) ? "Local account" : User.Email)</span>
            <span class="profile-badge-pill">🔒 Local Vault #@User.Id</span>
        </div>
    </div>

    @* Financial Snapshot Tiles *@
    <div class="analytics-stat-grid">
        <div class="analytics-stat-tile" id="tile-monthly-income">
            <span class="analytics-stat-label">Monthly income</span>
            <span class="analytics-stat-value" style="font-size:22px;">@UiFormat.Money(User.MonthlyIncome, User.CurrencySymbol, 0)</span>
            <span class="analytics-stat-caption">Base budget input</span>
        </div>
        <div class="analytics-stat-tile" id="tile-savings-goal">
            <span class="analytics-stat-label">Savings goal</span>
            <span class="analytics-stat-value" style="font-size:22px; color:var(--accent-emerald);">@UiFormat.Money(User.MonthlySavingsGoal, User.CurrencySymbol, 0)</span>
            <span class="analytics-stat-caption">Target savings/mo</span>
        </div>
    </div>

    @* Account Status & PBKDF2 PIN Card *@
    <div class="profile-card" id="card-security-status">
        <span class="profile-card-title">Security & Credentials</span>
        <div class="btn-row-2">
            <button id="btn-reset-pin" type="button" class="btn-secondary-action" @onclick="PromptResetPin">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <span>Reset PIN</span>
            </button>
            <button id="btn-test-auth" type="button" class="btn-secondary-action" @onclick="TestBiometrics">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2a10 10 0 0 0-10 10c0 3 1.5 6 4 8"></path>
                    <path d="M12 6a6 6 0 0 0-6 6c0 2 1 4 2.5 5"></path>
                </svg>
                <span>Test Biometrics</span>
            </button>
        </div>
        <p class="card-footnote">
            🔒 Local PIN is cryptographically hashed with PBKDF2 + SHA256 salt on-device. Zero data is shared externally.
        </p>
    </div>

    @* User Preferences *@
    <div class="profile-card" id="card-preferences">
        <span class="profile-card-title">Preferences</span>

        <div class="currency-selector-row">
            <span class="switch-title">Currency</span>
            <div class="currency-pills">
                @foreach (var c in AvailableCurrencies)
                {
                    <button type="button" class="currency-pill-btn @(User.CurrencySymbol == c ? "active" : "")"
                            @onclick="() => SetCurrency(c)">
                        @c
                    </button>
                }
            </div>
        </div>

        <div class="switch-container bordered-top">
            <div class="switch-label-group">
                <span class="switch-title">Biometric / FaceID unlock</span>
                <span class="switch-desc">Require fingerprint or Face ID to open app</span>
            </div>
            <ToggleSwitch Id="toggle-biometrics" Value="BiometricsEnabled" ValueChanged="OnToggleBiometrics" />
        </div>
    </div>

    @* Link to Settings *@
    <div class="profile-nav-row" id="link-goto-settings" @onclick="GoToSettings">
        <div class="profile-nav-left">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
            <span>Settings & ML configuration</span>
        </div>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
    </div>

    @* Lock App / Logout Button *@
    <button id="btn-lock-app" type="button" class="btn-logout" @onclick="LockApp">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        <span>Lock App</span>
    </button>
</div>

@code {
    private static readonly string[] AvailableCurrencies = { "FCFA", "€", "$", "£", "MAD" };

    private UserProfile User = new()
    {
        Id = 1,
        FullName = "Local User",
        Email = string.Empty,
        CurrencySymbol = "FCFA",
        MonthlyIncome = 0m,
        MonthlySavingsGoal = 0m,
        IsOnboardingCompleted = true
    };

    private bool BiometricsEnabled = false;
    private string? StatusMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var profile = await AuthService.GetUserProfileAsync();
            if (profile != null)
            {
                User = profile;
            }
            BiometricsEnabled = await AuthService.IsBiometricEnabledAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading user profile in Profile page.");
            StatusMessage = $"Could not load profile: {ex.Message}";
        }
    }

    private async Task SetCurrency(string symbol)
    {
        User.CurrencySymbol = symbol;
        try
        {
            await AuthService.UpdateUserProfileAsync(User);
            StatusMessage = $"Currency updated to {symbol}.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to update user currency.");
            StatusMessage = $"Failed to save currency: {ex.Message}";
        }
    }

    private async Task OnToggleBiometrics(bool enabled)
    {
        BiometricsEnabled = enabled;
        try
        {
            await AuthService.SetBiometricEnabledAsync(enabled);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to update biometric preference.");
            StatusMessage = $"Failed to update biometric setting: {ex.Message}";
        }
    }

    private void PromptResetPin() => NavManager.NavigateTo("onboarding");

    private async Task TestBiometrics()
    {
        try
        {
            var ok = await AuthService.AuthenticateWithBiometricsAsync("Authenticate to verify your biometrics");
            StatusMessage = ok ? "Biometric authentication succeeded." : "Biometric authentication was not verified.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Biometric test threw an exception.");
            StatusMessage = $"Biometric check unavailable: {ex.Message}";
        }
    }

    private void GoToSettings() => NavManager.NavigateTo("settings");

    private void LockApp()
    {
        AuthService.LockApp();
        NavManager.NavigateTo("unlock");
    }
}
