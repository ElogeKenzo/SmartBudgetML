@page "/onboarding"
@inject NavigationManager NavManager

<PageTitle>Create your account · SmartBudget ML</PageTitle>

<section class="onboarding">
    <div class="onboarding-hero">
        <div class="brand-title brand-title-lg">SmartBudget <span class="brand-ml-tag">ML</span></div>
        <h1 class="page-title">@(_step == 1 ? "Create your account" : "Secure your data")</h1>
        <p class="page-subtitle">
            @(_step == 1
                ? "Your profile never leaves this device. No cloud, no tracking."
                : "Set a local PIN. Biometrics can replace it on supported devices.")
        </p>

        <div class="stepper" aria-label="Onboarding progress">
            <span class="stepper-dot @(_step >= 1 ? "active" : "")"></span>
            <span class="stepper-bar @(_step >= 2 ? "active" : "")"></span>
            <span class="stepper-dot @(_step >= 2 ? "active" : "")"></span>
        </div>
    </div>

    @if (_step == 1)
    {
        <div class="card-dark form-card">
            <div class="form-group-dark">
                <label class="form-label-dark" for="input-fullname">Full name</label>
                <input id="input-fullname" class="form-input-dark" placeholder="Enter your full name"
                       @bind="_model.FullName" @bind:event="oninput" autocomplete="name" />
            </div>

            <div class="form-group-dark">
                <label class="form-label-dark" for="input-email">Email <span class="optional">(optional)</span></label>
                <input id="input-email" type="email" class="form-input-dark" placeholder="you@example.com"
                       @bind="_model.Email" autocomplete="email" />
            </div>

            <div class="form-row">
                <div class="form-group-dark currency-field">
                    <label class="form-label-dark" for="select-currency">Currency</label>
                    <select id="select-currency" class="form-input-dark" @bind="_model.CurrencySymbol">
                        @foreach (var c in Currencies)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                </div>
                <div class="form-group-dark flex-1">
                    <label class="form-label-dark" for="input-income">Monthly income</label>
                    <input id="input-income" type="number" inputmode="decimal" min="0" step="50" class="form-input-dark"
                           placeholder="3500" @bind="_model.MonthlyIncome" />
                </div>
            </div>

            <div class="form-group-dark">
                <label class="form-label-dark" for="input-savings">Monthly savings goal</label>
                <input id="input-savings" type="number" inputmode="decimal" min="0" step="50" class="form-input-dark"
                       placeholder="500" @bind="_model.MonthlySavingsGoal" />
            </div>

            @if (_error is not null)
            {
                <div class="form-error" role="alert">@_error</div>
            }

            <button id="btn-onboarding-next" type="button" class="btn-primary-gradient" @onclick="GoToSecurity">
                Continue
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 5l7 7-7 7"></path></svg>
            </button>
        </div>
    }
    else
    {
        <div class="card-dark form-card">
            <div class="form-group-dark">
                <label class="form-label-dark" for="input-pin">4-digit PIN</label>
                <input id="input-pin" type="password" inputmode="numeric" maxlength="4" class="form-input-dark pin-input"
                       placeholder="••••" @bind="_model.Pin" @bind:event="oninput" autocomplete="new-password" />
            </div>

            <div class="form-group-dark">
                <label class="form-label-dark" for="input-pin-confirm">Confirm PIN</label>
                <input id="input-pin-confirm" type="password" inputmode="numeric" maxlength="4" class="form-input-dark pin-input"
                       placeholder="••••" @bind="_model.PinConfirm" @bind:event="oninput" autocomplete="new-password" />
            </div>

            <div class="switch-container bordered-top">
                <div class="switch-label-group">
                    <span class="switch-title">Unlock with biometrics</span>
                    <span class="switch-desc">Fingerprint or Face ID, processed by your OS</span>
                </div>
                <ToggleSwitch Id="toggle-onboarding-biometric" @bind-Value="_model.EnableBiometrics" />
            </div>

            @if (_error is not null)
            {
                <div class="form-error" role="alert">@_error</div>
            }

            <button id="btn-register" type="button" class="btn-primary-gradient" disabled="@_busy" @onclick="Register">
                @(_busy ? "Creating your vault…" : "Register")
            </button>
            <button id="btn-onboarding-back" type="button" class="btn-ghost" @onclick="() => { _step = 1; _error = null; }">
                Back
            </button>
        </div>
    }

    <p class="privacy-footnote">
        🔒 Data encrypted at rest with a PBKDF2-hashed PIN · ML runs 100% on-device
    </p>
</section>

@inject ILocalAuthService AuthService

@code {
    private static readonly string[] Currencies = { "$", "€", "£", "FCFA", "MAD", "¥" };

    private int _step = 1;
    private bool _busy;
    private string? _error;
    private readonly OnboardingForm _model = new();

    private void GoToSecurity()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_model.FullName))
        {
            _error = "Please enter your name.";
            return;
        }
        if (_model.MonthlyIncome < 0 || _model.MonthlySavingsGoal < 0)
        {
            _error = "Amounts cannot be negative.";
            return;
        }
        _step = 2;
    }

    private async Task Register()
    {
        _error = null;
        if (_model.Pin.Length != 4 || !_model.Pin.All(char.IsDigit))
        {
            _error = "PIN must be exactly 4 digits.";
            return;
        }
        if (_model.Pin != _model.PinConfirm)
        {
            _error = "PINs do not match.";
            return;
        }

        _busy = true;
        try
        {
            await AuthService.CompleteOnboardingAsync(
                _model.FullName.Trim(),
                _model.CurrencySymbol,
                _model.MonthlyIncome,
                _model.Pin,
                _model.EnableBiometrics,
                _model.MonthlySavingsGoal);

            AuthService.MarkAppUnlocked();
            NavManager.NavigateTo("");
        }
        catch (Exception ex)
        {
            _error = $"Registration failed: {ex.Message}";
        }
        finally
        {
            _model.Pin = _model.PinConfirm = string.Empty;
            _busy = false;
        }
    }

    private sealed class OnboardingForm
    {
        public string FullName { get; set; } = string.Empty;
        public string? Email { get; set; }
        public string CurrencySymbol { get; set; } = "$";
        public decimal MonthlyIncome { get; set; }
        public decimal MonthlySavingsGoal { get; set; }
        public string Pin { get; set; } = string.Empty;
        public string PinConfirm { get; set; } = string.Empty;
        public bool EnableBiometrics { get; set; } = true;
    }
}
