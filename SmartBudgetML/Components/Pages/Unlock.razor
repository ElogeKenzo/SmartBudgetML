@page "/unlock"
@inject NavigationManager NavManager
@inject ILocalAuthService AuthService

<PageTitle>Unlock · SmartBudget ML</PageTitle>

<LockScreen Subtitle="Enter your 4-digit PIN to access your vault"
            ErrorMessage="@ErrorMessage"
            ShowBiometric="true"
            OnPinComplete="HandlePinComplete"
            OnBiometricRequested="HandleBiometricUnlock" />

@code {
    private string? ErrorMessage;

    private async Task HandlePinComplete(string pin)
    {
        ErrorMessage = null;
        try
        {
            var isValid = await AuthService.VerifyPinAsync(pin);
            if (isValid)
            {
                AuthService.MarkAppUnlocked();
                NavManager.NavigateTo("");
            }
            else
            {
                ErrorMessage = "Incorrect PIN. Please try again.";
            }
        }
        catch
        {
            // For initial preview fallback if no PIN was registered
            if (pin == "1234")
            {
                AuthService.MarkAppUnlocked();
                NavManager.NavigateTo("");
            }
            else
            {
                ErrorMessage = "Incorrect PIN.";
            }
        }
    }

    private async Task HandleBiometricUnlock()
    {
        try
        {
            var authenticated = await AuthService.AuthenticateWithBiometricsAsync("Unlock SmartBudget ML");
            if (authenticated)
            {
                AuthService.MarkAppUnlocked();
                NavManager.NavigateTo("");
            }
            else
            {
                ErrorMessage = "Biometric authentication failed.";
            }
        }
        catch
        {
            // Handled
        }
    }
}
