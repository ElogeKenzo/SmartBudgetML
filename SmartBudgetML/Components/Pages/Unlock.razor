@page "/unlock"
@using Microsoft.Extensions.Logging
@inject NavigationManager NavManager
@inject ILocalAuthService AuthService
@inject ILogger<Unlock> Logger

<PageTitle>Unlock · SmartBudget ML</PageTitle>

<LockScreen Subtitle="@($"Enter your {PinLength}-digit PIN to access your vault")"
            PinLength="@PinLength"
            IsLockedOut="@IsLockedOut"
            ErrorMessage="@ErrorMessage"
            ShowBiometric="true"
            OnPinComplete="HandlePinComplete"
            OnBiometricRequested="HandleBiometricUnlock" />

@code {
    private string? ErrorMessage;
    private int PinLength = 6;
    private bool IsLockedOut = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settings = await AuthService.GetSettingsAsync();
            PinLength = settings.PinLength == 4 ? 4 : 6;

            var remaining = await AuthService.GetRemainingLockoutTimeAsync();
            if (remaining.HasValue && remaining.Value > TimeSpan.Zero)
            {
                IsLockedOut = true;
                ErrorMessage = $"Locked due to failed attempts. Retry in {Math.Ceiling(remaining.Value.TotalSeconds):0}s.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing Unlock screen.");
        }
    }

    private async Task HandlePinComplete(string pin)
    {
        ErrorMessage = null;
        try
        {
            var result = await AuthService.VerifyPinWithStatusAsync(pin);
            if (result.IsValid)
            {
                IsLockedOut = false;
                AuthService.MarkAppUnlocked();
                NavManager.NavigateTo("");
            }
            else
            {
                IsLockedOut = result.IsLockedOut;
                ErrorMessage = result.ErrorMessage ?? "Incorrect PIN. Please try again.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error verifying PIN during unlock.");
            ErrorMessage = "Unable to verify PIN. Please try again.";
        }
    }

    private async Task HandleBiometricUnlock()
    {
        try
        {
            var authenticated = await AuthService.AuthenticateWithBiometricsAsync("Unlock SmartBudget ML");
            if (authenticated)
            {
                AuthService.MarkAppUnlocked();
                NavManager.NavigateTo("");
            }
            else
            {
                ErrorMessage = "Biometric authentication failed.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Biometric unlock failed with exception.");
            ErrorMessage = "Biometric authentication is currently unavailable.";
        }
    }
}
