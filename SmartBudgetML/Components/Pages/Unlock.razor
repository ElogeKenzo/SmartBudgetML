@page "/unlock"
@using Microsoft.Extensions.Logging
@inject NavigationManager NavManager
@inject ILocalAuthService AuthService
@inject IStringLocalizer<AppStrings> L
@inject ILogger<Unlock> Logger

<PageTitle>@L["Unlock_PageTitle"]</PageTitle>

<LockScreen Subtitle="@L["Unlock_Subtitle", PinLength].Value"
            PinLength="@PinLength"
            IsLockedOut="@IsLockedOut"
            ErrorMessage="@ErrorMessage"
            IsVerifying="@IsVerifying"
            VerifyingText="@L["Unlock_Verifying"].Value"
            ShowBiometric="true"
            OnPinComplete="HandlePinComplete"
            OnBiometricRequested="HandleBiometricUnlock" />

@code {
    private string? ErrorMessage;
    private int PinLength = 6;
    private bool IsLockedOut = false;
    private bool IsVerifying = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settings = await AuthService.GetSettingsAsync();
            PinLength = settings.PinLength == 4 ? 4 : 6;

            var remaining = await AuthService.GetRemainingLockoutTimeAsync();
            if (remaining.HasValue && remaining.Value > TimeSpan.Zero)
            {
                IsLockedOut = true;
                ErrorMessage = L["Unlock_LockedRetryIn", Math.Ceiling(remaining.Value.TotalSeconds)].Value;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing Unlock screen.");
        }
    }

    private async Task HandlePinComplete(string pin)
    {
        ErrorMessage = null;
        IsVerifying = true;
        try
        {
            // PBKDF2 runs off the UI thread; yield once so "Verifying…" renders first.
            await Task.Yield();
            var result = await AuthService.VerifyPinWithStatusAsync(pin);
            if (result.IsValid)
            {
                IsLockedOut = false;
                AuthService.MarkAppUnlocked();
                NavManager.NavigateTo("");
            }
            else
            {
                IsLockedOut = result.IsLockedOut;
                ErrorMessage = result.IsLockedOut
                    ? L["Unlock_LockedRetryIn", Math.Ceiling(result.RemainingLockout.TotalSeconds)].Value
                    : L["Unlock_IncorrectPin"].Value;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error verifying PIN during unlock.");
            ErrorMessage = L["Unlock_IncorrectPin"].Value;
        }
        finally
        {
            IsVerifying = false;
        }
    }

    private async Task HandleBiometricUnlock()
    {
        try
        {
            var authenticated = await AuthService.AuthenticateWithBiometricsAsync(L["Shared_UseBiometrics"].Value);
            if (authenticated)
            {
                AuthService.MarkAppUnlocked();
                NavManager.NavigateTo("");
            }
            else
            {
                ErrorMessage = L["Unlock_BiometricFailed"].Value;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Biometric unlock failed with exception.");
            ErrorMessage = L["Unlock_BiometricFailed"].Value;
        }
    }
}
