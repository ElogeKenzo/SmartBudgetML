@page "/"

<PageTitle>Dashboard · SmartBudget ML</PageTitle>
<h1 class="visually-hidden">Dashboard</h1>

@* ---------- Hero: remaining budget ---------- *@
<section class="card-hero-gradient" id="card-remaining-budget">
    <div class="hero-top-row">
        <span class="hero-label">Remaining this month</span>
        <span class="hero-change-pill @(Forecast.ProjectedSurplusOrDeficit >= 0 ? "positive" : "negative")">
            @(Forecast.ProjectedSurplusOrDeficit >= 0 ? "▲ On track" : "▼ Over pace")
        </span>
    </div>
    <div class="hero-amount">@UiFormat.Money(Remaining, Currency)</div>
    <div class="hero-meta-row">
        <span>Spent <strong>@UiFormat.Money(Forecast.CurrentTotalSpend, Currency)</strong></span>
        <span>of @UiFormat.Money(Forecast.MonthlyBudget, Currency, 0)</span>
    </div>

    <div class="budget-progress-track" role="progressbar" aria-valuenow="@((int)SpentPercent)" aria-valuemin="0" aria-valuemax="100">
        <div class="budget-progress-fill @ProgressClass" style="width:@UiFormat.Num(Math.Min(SpentPercent, 100))%"></div>
    </div>
    <div class="hero-meta-row muted">
        <span>@Forecast.DaysRemaining days left</span>
        <span>Safe daily limit <strong class="cyan">@UiFormat.Money(Forecast.RecommendedDailyLimit, Currency)</strong></span>
    </div>
</section>

@* ---------- ML forecast insight ---------- *@
<section class="ml-insight-banner status-@Forecast.Status.ToString().ToLowerInvariant()" id="banner-ml-forecast">
    <div class="ml-sparkle-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M12 3l1.9 5.8L20 10l-6.1 1.2L12 17l-1.9-5.8L4 10l6.1-1.2z"></path></svg>
    </div>
    <div class="ml-insight-text">
        <strong>ML forecast:</strong> you'll spend about
        <strong>@UiFormat.Money(Forecast.ProjectedEndMonthSpend, Currency, 0)</strong> by month-end
        (@UiFormat.Percent(Forecast.ProjectedBudgetUtilizationPercentage) of budget).
    </div>
</section>

@* ---------- Quick stats ---------- *@
<section class="stat-grid">
    <div class="stat-tile" id="stat-daily-average">
        <span class="stat-label">Daily average</span>
        <span class="stat-value">@UiFormat.Money(Forecast.AverageDailySpend, Currency)</span>
    </div>
    <div class="stat-tile" id="stat-burn-rate">
        <span class="stat-label">Burn-rate trend</span>
        <span class="stat-value">@UiFormat.Money(Forecast.DailyBurnRateSlope, Currency)<small>/day</small></span>
    </div>
</section>

@* ---------- Recent transactions ---------- *@
<section>
    <div class="section-header">
        <h2 class="section-title">Recent transactions</h2>
        <a class="section-link" href="analytics" id="link-see-all">See all</a>
    </div>

    @if (RecentTransactions.Count == 0)
    {
        <div class="empty-state">
            <span class="empty-emoji">🧾</span>
            <p>No expenses yet. Tap <strong>+</strong> to add your first one.</p>
        </div>
    }
    else
    {
        <div class="transaction-list">
            @foreach (var t in RecentTransactions)
            {
                <TransactionItem Item="t" CurrencySymbol="@Currency" />
            }
        </div>
    }
</section>

@inject IDatabaseService DbService
@inject ILocalAuthService AuthService
@inject IBudgetForecastingService Forecaster
@inject NavigationManager NavManager

@code {
    private string Currency = "$";
    private BudgetForecastResult Forecast = new();
    private List<Expense> RecentTransactions = new();

    private decimal Remaining => Forecast.MonthlyBudget - Forecast.CurrentTotalSpend;

    private double SpentPercent => Forecast.MonthlyBudget <= 0
        ? 0
        : (double)(Forecast.CurrentTotalSpend / Forecast.MonthlyBudget) * 100.0;

    private string ProgressClass => Forecast.Status switch
    {
        BudgetHealthStatus.Exceeded => "danger",
        BudgetHealthStatus.Warning => "warning",
        _ => ""
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardDataAsync();
    }

    private async Task LoadDashboardDataAsync()
    {
        try
        {
            var profile = await AuthService.GetUserProfileAsync();
            if (profile != null)
            {
                Currency = profile.CurrencySymbol;
            }

            decimal monthlyBudget = (profile != null && profile.MonthlyIncome > 0)
                ? Math.Max(100m, profile.MonthlyIncome - profile.MonthlySavingsGoal)
                : 3000m;

            var allExpenses = await DbService.Expenses.GetAllAsync();
            var allCategories = await DbService.Categories.GetAllAsync();
            var catDict = allCategories.ToDictionary(c => c.Id);

            foreach (var exp in allExpenses)
            {
                if (catDict.TryGetValue(exp.CategoryId, out var cat))
                {
                    exp.CategoryName = cat.Name;
                    exp.CategoryColor = cat.ColorHex;
                    exp.CategoryIcon = cat.Icon;
                }
            }

            var today = DateTime.Today;
            var monthExpenses = allExpenses
                .Where(e => e.Date.Month == today.Month && e.Date.Year == today.Year)
                .ToList();

            // Run on-device Linear Regression forecasting
            Forecast = Forecaster.ForecastMonthEnd(monthExpenses, monthlyBudget, today);

            // Latest 5 transactions
            RecentTransactions = allExpenses
                .OrderByDescending(e => e.Date)
                .ThenByDescending(e => e.Id)
                .Take(5)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Home] Error loading dashboard: {ex.Message}");
        }
    }
}
