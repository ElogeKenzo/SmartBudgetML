<div class="keypad-grid" role="group" aria-label="Numeric keypad">
    @foreach (var key in Keys)
    {
        var k = key;
        if (k == LeftKeyToken)
        {
            if (LeftKey == KeypadLeftKey.Decimal)
            {
                <button id="@($"{IdPrefix}-key-dot")" type="button" class="keypad-btn" @onclick='() => OnKey.InvokeAsync(".")'>.</button>
            }
            else if (LeftKey == KeypadLeftKey.Biometric)
            {
                <button id="@($"{IdPrefix}-key-bio")" type="button" class="keypad-btn action" title="Use biometrics"
                        @onclick='() => OnKey.InvokeAsync("bio")'>
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2a10 10 0 0 0-10 10c0 3 1.5 6 4 8"></path>
                        <path d="M12 6a6 6 0 0 0-6 6c0 2 1 4 2.5 5"></path>
                        <path d="M12 10a2 2 0 0 0-2 2c0 1 .5 2 1.2 2.5"></path>
                        <path d="M22 12a10 10 0 0 0-3-7.1"></path>
                    </svg>
                </button>
            }
            else
            {
                <span></span>
            }
        }
        else if (k == "back")
        {
            <button id="@($"{IdPrefix}-key-back")" type="button" class="keypad-btn action" title="Delete"
                    @onclick='() => OnKey.InvokeAsync("back")'>⌫</button>
        }
        else
        {
            <button id="@($"{IdPrefix}-key-{k}")" type="button" class="keypad-btn" @onclick="() => OnKey.InvokeAsync(k)">@k</button>
        }
    }
</div>

@code {
    private const string LeftKeyToken = "left";
    private static readonly string[] Keys = { "1", "2", "3", "4", "5", "6", "7", "8", "9", LeftKeyToken, "0", "back" };

    /// <summary>Emits "0"-"9", ".", "back" or "bio".</summary>
    [Parameter] public EventCallback<string> OnKey { get; set; }
    [Parameter] public KeypadLeftKey LeftKey { get; set; } = KeypadLeftKey.Decimal;
    [Parameter] public string IdPrefix { get; set; } = "keypad";
}
