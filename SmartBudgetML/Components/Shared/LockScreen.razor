<div class="lock-overlay" id="lock-screen">
    <div class="lock-card">
        <div class="lock-icon-glow">
            <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
        </div>
        <h1 class="lock-title">SmartBudget <span>ML</span></h1>
        <p class="lock-sub">@Subtitle</p>

        <div class="pin-dots @(HasError ? "shake" : "")" aria-label="PIN progress">
            @for (var i = 0; i < PinLength; i++)
            {
                <div class="pin-dot @(_pin.Length > i ? "filled" : "")"></div>
            }
        </div>

        @if (IsVerifying)
        {
            <div class="lock-sub" id="lock-verifying" role="status">@VerifyingText</div>
        }
        else
        {
            <div class="lock-error" role="alert">@ErrorMessage</div>
        }

        <div class="lock-keypad">
            <NumericKeypad IdPrefix="lock" Disabled="@IsVerifying" LeftKey="@(ShowBiometric ? KeypadLeftKey.Biometric : KeypadLeftKey.None)" OnKey="HandleKey" />
        </div>
    </div>
</div>

@code {
    private string _pin = string.Empty;

    [Parameter] public int PinLength { get; set; } = 6;
    [Parameter] public bool IsLockedOut { get; set; } = false;
    [Parameter] public string Subtitle { get; set; } = "Enter your PIN to unlock";
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public bool ShowBiometric { get; set; } = true;
    [Parameter] public bool IsVerifying { get; set; }
    [Parameter] public string? VerifyingText { get; set; }

    [Parameter] public EventCallback<string> OnPinComplete { get; set; }
    [Parameter] public EventCallback OnBiometricRequested { get; set; }

    private bool HasError => !string.IsNullOrEmpty(ErrorMessage);

    private async Task HandleKey(string key)
    {
        if (IsLockedOut || IsVerifying)
        {
            _pin = string.Empty;
            return;
        }

        switch (key)
        {
            case "bio":
                await OnBiometricRequested.InvokeAsync();
                return;
            case "back":
                if (_pin.Length > 0) _pin = _pin[..^1];
                return;
            case ".":
                return;
        }

        var targetLen = PinLength == 4 ? 4 : 6;
        if (_pin.Length >= targetLen) return;
        _pin += key;

        if (_pin.Length == targetLen)
        {
            var completed = _pin;
            _pin = string.Empty;
            await OnPinComplete.InvokeAsync(completed);
        }
    }
}
