@inject IStringLocalizer<AppStrings> L

<div class="transaction-card" id="@($"txn-{Item.Id}")">
    <div class="transaction-left">
        <div class="transaction-category-icon" style="background:@UiFormat.TileBackground(Item.CategoryColor)">
            @UiFormat.CategoryGlyph(Item.CategoryIcon)
        </div>
        <div class="transaction-meta">
            <span class="transaction-desc">@Item.Description</span>
            <span class="transaction-cat-name">
                @(Item.CategoryName ?? L["Shared_Uncategorized"].Value)
                @if (Item.IsMlPredicted)
                {
                    <span class="ml-auto-badge" title="@L["Settings_OnDeviceMlBadge"]">@L["Shared_AiBadge"]</span>
                }
                <span class="transaction-date">· @Item.Date.ToString("MMM d", L.CurrentLanguage.StartsWith("en", StringComparison.OrdinalIgnoreCase) ? System.Globalization.CultureInfo.GetCultureInfo("en-US") : System.Globalization.CultureInfo.GetCultureInfo("fr-FR"))</span>
            </span>
        </div>
    </div>
    <span class="transaction-amount @(Item.IsIncome ? "income" : "expense")">
        @(Item.IsIncome ? "+" : "-")@UiFormat.Money(Item.Amount, CurrencySymbol)
    </span>
</div>

@code {
    [Parameter, EditorRequired] public Expense Item { get; set; } = default!;
    [Parameter] public string CurrencySymbol { get; set; } = "FCFA";
}
