<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML" Version="3.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="sqlite-net-sqlcipher" Version="1.9.172" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Shared source link to platform-agnostic models and services in main project.
    Excludes hardware-dependent MAUI implementations which are mocked/substituted in tests.
  -->
  <ItemGroup>
    <Compile Include="..\SmartBudgetML\Models\**\*.cs" LinkBase="Models" />
    <Compile Include="..\SmartBudgetML\Services\**\*.cs"
             Exclude="..\SmartBudgetML\Services\Auth\BiometricService.cs;..\SmartBudgetML\Services\Security\MauiSecureKeyStore.cs"
             LinkBase="Services" />
    <Compile Include="..\SmartBudgetML\Components\Shared\UiFormat.cs" LinkBase="Components\Shared" />
  </ItemGroup>

</Project>
