<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
    <DefineConstants>$(DefineConstants);SB_SELFTEST</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML" Version="3.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="sqlite-net-sqlcipher" Version="1.9.172" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\SmartBudgetML\Models\**\*.cs" LinkBase="Models" />
    <Compile Include="..\SmartBudgetML\Services\**\*.cs" Exclude="..\SmartBudgetML\Services\Auth\BiometricService.cs;..\SmartBudgetML\Services\Security\MauiSecureKeyStore.cs;..\SmartBudgetML\Services\Data\MauiFileExportService.cs" LinkBase="Services" />
    <Compile Include="..\SmartBudgetML\Resources\Strings\AppStrings.cs" LinkBase="Resources\Strings" />
    <Compile Include="..\SmartBudgetML\Components\Shared\UiFormat.cs" LinkBase="Components\Shared" />
    <None Include="..\SmartBudgetML\Resources\Raw\*.csv" CopyToOutputDirectory="PreserveNewest" LinkBase="Resources\Raw" />
    <None Include="..\SmartBudgetML\Resources\Strings\*.resx" CopyToOutputDirectory="PreserveNewest" LinkBase="Resources\Strings" />
  </ItemGroup>

</Project>
